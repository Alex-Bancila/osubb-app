# Copy to app/.env.local (git-ignored) and restart `npm run dev`.
#
# Local values: run `npx supabase status` in the repo root and take API_URL and
# ANON_KEY. They are the same on every machine, so the ones below usually work
# as-is.
#
# Staging/production values come from the Supabase dashboard → Project Settings
# → API. Both are safe in a bundle — the anon key is a PUBLIC key and grants
# nothing by itself; RLS decides what any request may actually see.
#
# The service key is NOT here and must never be: it bypasses RLS entirely and
# belongs only to Edge Functions and CI secrets.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Web Push (ADR-0010, #704): the environment's VAPID PUBLIC key, base64url, as
# `npx web-push generate-vapid-keys` printed it (docs/backend/push.md, step 1).
# Public by design — the private half stays a `send-push` function secret.
# Leave it empty and the Profil switch says push is not available yet; each
# environment (local, staging, production) has its own pair.
VITE_VAPID_PUBLIC_KEY=
