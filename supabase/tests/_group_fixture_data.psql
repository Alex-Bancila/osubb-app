-- Temporary input rows for the historical command matrices. No client policy,
-- trigger, write grant or production compatibility object is recreated.
create temp table fixture_departments(id text primary key, name text, short text, color text, kind text default 'department') on commit drop;
create temp table fixture_teams(id text primary key, name text, dept_id text, is_interne boolean default false) on commit drop;
create temp table fixture_projects(id bigint generated by default as identity primary key, name text, status text default 'active', leader_id uuid, created_by uuid, created_at timestamptz default now(), updated_at timestamptz default now()) on commit drop;
create temp table fixture_member_departments(member_id uuid, dept_id text, primary key(member_id,dept_id)) on commit drop;
create temp table fixture_team_members(team_id text, member_id uuid, primary key(team_id,member_id)) on commit drop;
create temp table fixture_project_members(project_id bigint, member_id uuid, project_role text default 'member', created_at timestamptz default now(), primary key(project_id,member_id)) on commit drop;
insert into fixture_departments(id,name,short,color,kind)
select legacy_dept_id,name,short,color,case when competes_in_cup then 'department' else 'coordination' end
from public.groups where legacy_dept_id is not null;

grant select on fixture_departments,fixture_teams,fixture_projects,fixture_member_departments,fixture_team_members,fixture_project_members to authenticated;
