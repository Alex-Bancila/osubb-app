-- #521: reusable rolled-back Group fixtures for the existing command matrices.
-- Included explicitly; .psql keeps the CLI from discovering it as a standalone suite.
--
-- #586: every Group and roster row is native fixture data. The legacy rows
-- below remain only for suites that still inspect the old tables; changing
-- one of those rows no longer changes Group authority.
reset role;
create function pg_temp.g521_uid(n integer) returns uuid language sql immutable as $$
  select ('52100000-0000-0000-0000-' || lpad(n::text,12,'0'))::uuid
$$;
insert into auth.users(id,email)
select pg_temp.g521_uid(n),'member.'||n||'.521@test.local' from generate_series(1,12) n;
insert into public.profiles(id,full_name,email,role,status)
select pg_temp.g521_uid(n),'Member #521 '||n,'member.'||n||'.521@test.local',
(case when n=1 then 'bc' when n=9 then 'bce' when n=12 then 'vot' else 'voluntar' end)::public.member_role,'activ'
from generate_series(1,12) n;

-- ==================== #578: groups/group_members, asserted directly ====================
-- The corresponding legacy rows are retained below solely as historical read fixtures.
insert into public.groups(name,category,competes_in_cup,application_level,manager_title,short,color) values ('Department #521','department',true,1,'BCE','D521','#123456');
insert into public.groups(name,category,parent_id,application_level,shared_work_visibility,manager_title) values ('Child #521','team',(select id from public.groups where name='Department #521'),0,true,'Coordonator');
insert into public.groups(name,category,application_level,shared_work_visibility) values ('Independent #521','team',0,true);
insert into public.groups(name,category,application_level,manager_title,created_by) values ('Project #521','project',0,'Coordonator Principal',pg_temp.g521_uid(1)),('Archived #521','project',0,'Coordonator Principal',pg_temp.g521_uid(1));

insert into public.group_members(group_id,member_id,group_role)
select id,pg_temp.g521_uid(5),'member' from public.groups where name='Department #521'
union all
select id,pg_temp.g521_uid(9),'manager' from public.groups where name='Department #521'
union all
select id,pg_temp.g521_uid(8),'member' from public.groups where name='Child #521'
union all
select id,pg_temp.g521_uid(6),'responsible' from public.groups where name='Independent #521'
union all
select id,pg_temp.g521_uid(7),'responsible' from public.groups where name='Independent #521'
union all
select id,pg_temp.g521_uid(2),'manager' from public.groups where name in ('Project #521','Archived #521')
union all
select id,pg_temp.g521_uid(n),case when n in (3,4) then 'responsible' else 'member' end
from public.groups cross join generate_series(3,5) n where name='Project #521';

-- ==================== Legacy compatibility rows (unchanged shape) ====================
insert into pg_temp.fixture_departments(id,name,short,color,kind) values ('d521','Department #521','D521','#123456','department');
insert into pg_temp.fixture_member_departments(member_id,dept_id) values
(pg_temp.g521_uid(5),'d521'),(pg_temp.g521_uid(9),'d521');
insert into pg_temp.fixture_teams(id,name,dept_id) values ('dt521','Child #521','d521'),('ind521','Independent #521',null);
insert into pg_temp.fixture_team_members(team_id,member_id) values
('dt521',pg_temp.g521_uid(8)),('ind521',pg_temp.g521_uid(6)),('ind521',pg_temp.g521_uid(7));
insert into pg_temp.fixture_projects(id,name,leader_id,created_by) overriding system value values
(521000000001,'Project #521',pg_temp.g521_uid(2),pg_temp.g521_uid(1)),
(521000000002,'Archived #521',pg_temp.g521_uid(2),pg_temp.g521_uid(1));
insert into pg_temp.fixture_project_members(project_id,member_id,project_role)
select p.id,pg_temp.g521_uid(n),case when n in (3,4) then 'responsible' else 'member' end
from pg_temp.fixture_projects p cross join generate_series(3,5) n where p.name='Project #521';
update pg_temp.fixture_projects set status='archived' where name='Archived #521';
update public.groups set status='archived' where name='Archived #521';
create temp table g521_tasks(name text primary key,id bigint);
grant select on g521_tasks to authenticated;
create function pg_temp.g521_task(p_name text,p_origin text,p_executor integer default null,
 p_status text default 'todo',p_mode text default 'direct',p_kind text default 'task')
returns bigint language plpgsql as $$
declare v_id bigint; v_saved text := current_setting('request.jwt.claims',true);
begin
  insert into public.tasks(title,group_id,created_by,deadline,status,audience,assignment_mode,kind,started_at,submitted_at,created_at,queue_opened_at)
  values ('Group #521 '||p_name,
    (select id from public.groups where name = case p_origin
       when 'dept' then 'Department #521' when 'dt' then 'Child #521'
       when 'ind' then 'Independent #521' when 'project' then 'Project #521'
       when 'archived' then 'Archived #521' end),
    pg_temp.g521_uid(1),now()-interval '1 day',
    (case when p_status='completed' then 'in_review' else p_status end)::public.task_status,
    case when p_kind='task' then 'org' end,case when p_kind='task' then p_mode end,p_kind,
    case when p_status in ('in_progress','in_review','completed') then now()-interval '3 days' end,
    case when p_status in ('in_review','completed') then now()-interval '2 days' end,now()-interval '4 days',case when p_mode='public' and p_kind='task' then now()-interval '4 days' end) returning id into v_id;
  if p_executor is not null then
    insert into public.task_assignments(task_id,member_id,assigned_by,assigned_at)
    values(v_id,pg_temp.g521_uid(p_executor),pg_temp.g521_uid(1),now()-interval '3 days');
  end if;
  if p_status='completed' then
    perform set_config('request.jwt.claims',jsonb_build_object('sub',pg_temp.g521_uid(1),'role','authenticated',
      'app_metadata',jsonb_build_object('member_role','bc','member_level',6))::text,true);
    perform public.complete_task_review(v_id,3,3,'Fixture evaluation #521');
    perform set_config('request.jwt.claims',coalesce(v_saved,''),true);
  end if;
  insert into g521_tasks values(p_name,v_id);
  return v_id;
end;
$$;
